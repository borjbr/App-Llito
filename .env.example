# Copia este archivo como .env para desarrollo local.

# Base de datos. En local basta con el archivo SQLite; en producción, la URL de Turso.
TURSO_DATABASE_URL=file:local.db
# Solo en producción (Turso):
# TURSO_AUTH_TOKEN=

# Clave para firmar las sesiones. Genera una con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria

# URL pública de la app (en local, la de astro dev)
BETTER_AUTH_URL=http://localhost:4321

# Google Calendar (opcional). Ver docs/GOOGLE-CALENDAR.md
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Asistente Kissbell (OpenAI, de pago). Sin clave, el chat aparece como «no configurado».
# Crea la clave en https://platform.openai.com/api-keys y pon un límite de gasto en tu cuenta.
# OPENAI_API_KEY=
# Modelo (opcional): por defecto gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini
# Mensajes por hogar cada 24 horas (opcional): por defecto 100
# ASISTENTE_LIMITE_DIARIO=100
