---
/** Campo de texto accesible: etiqueta, ayuda y error enlazados al input. */
interface Props {
  id: string;
  label: string;
  type?: "text" | "email" | "number";
  value?: string | number | null;
  error?: string;
  hint?: string;
  autocomplete?: string;
  inputmode?: "text" | "numeric" | "email";
  required?: boolean;
  min?: number;
  max?: number;
}
const { id, label, type = "text", value, error, hint, autocomplete, inputmode, required = true, min, max } = Astro.props;
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(" ") || undefined;
---

<div class="field">
  <label class="label" for={id}>{label}</label>
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  <input
    class="input"
    id={id}
    name={id}
    type={type}
    value={value ?? ""}
    autocomplete={autocomplete}
    inputmode={inputmode}
    required={required}
    min={min}
    max={max}
    aria-invalid={error ? "true" : undefined}
    aria-describedby={describedBy}
  />
  {error && <p class="field-error" id={`${id}-error`}>{error}</p>}
</div>
