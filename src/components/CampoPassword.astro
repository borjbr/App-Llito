---
interface Props {
  id: string;
  label?: string;
  autocomplete: "current-password" | "new-password";
  error?: string;
  hint?: string;
}
const { id, label = "Contraseña", autocomplete, error, hint } = Astro.props;
const describedBy = [hint && `${id}-hint`, error && `${id}-error`].filter(Boolean).join(" ") || undefined;
---

<div class="field" data-password>
  <label class="label" for={id}>{label}</label>
  {hint && <p class="hint" id={`${id}-hint`}>{hint}</p>}
  <div class="relative">
    <input
      class="input"
      style="padding-right: 6.5rem;"
      id={id}
      name={id}
      type="password"
      autocomplete={autocomplete}
      required
      minlength={autocomplete === "new-password" ? 8 : undefined}
      aria-invalid={error ? "true" : undefined}
      aria-describedby={describedBy}
    />
    <button
      type="button"
      class="btn btn-ghost absolute right-1 top-1/2 -translate-y-1/2"
      style="min-height: 40px; padding-block: 0.3rem;"
      aria-pressed="false"
      aria-controls={id}
      hidden
    >
      Mostrar
    </button>
  </div>
  {error && <p class="field-error" id={`${id}-error`}>{error}</p>}
</div>

<script>
  // Botón «Mostrar / Ocultar» contraseña (solo aparece si hay JavaScript)
  document.querySelectorAll<HTMLElement>("[data-password]").forEach((campo) => {
    const input = campo.querySelector("input")!;
    const boton = campo.querySelector("button")!;
    boton.hidden = false;
    boton.addEventListener("click", () => {
      const visible = input.type === "text";
      input.type = visible ? "password" : "text";
      boton.textContent = visible ? "Mostrar" : "Ocultar";
      boton.setAttribute("aria-pressed", String(!visible));
    });
  });
</script>
