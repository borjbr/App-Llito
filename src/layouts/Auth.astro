---
import Base from "./Base.astro";

interface Props {
  title: string;
  heading: string;
  intro?: string;
}
const { title, heading, intro } = Astro.props;
---

<Base title={title}>
  <main id="contenido" class="gutter min-h-dvh flex flex-col justify-center" style="padding-block: 2rem 3rem;">
    <div class="w-full max-w-md mx-auto grid gap-6">
      <header class="grid gap-3">
        <p class="flex items-center gap-2 font-display text-lg font-bold" style="color: var(--accent);">
          <span aria-hidden="true" class="text-2xl">🏡</span> App-Llito
        </p>
        <h1>{heading}</h1>
        {intro && <p class="text-muted">{intro}</p>}
      </header>
      <slot />
    </div>
  </main>
</Base>
