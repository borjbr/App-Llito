---
import App from "@/layouts/App.astro";
import { historial, VERSION } from "@/lib/version";

const entradas = historial();
const fmt = new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const fecha = (f: string) => fmt.format(new Date(`${f}T12:00:00Z`));
---

<App title="Novedades">
  <header class="grid gap-2">
    <a href="/" class="btn btn-ghost volver"><span aria-hidden="true">←</span> Inicio</a>
    <h1>Novedades</h1>
    <p class="text-muted">Estás usando la versión <strong class="text-ink">{VERSION}</strong>.</p>
  </header>

  <ol class="versiones">
    {
      entradas.map((e) => (
        <li class="card version-item" data-actual={e.version === VERSION ? "si" : undefined}>
          <header class="flex items-baseline justify-between gap-2 flex-wrap">
            <h2>v{e.version} {e.version === VERSION && <span class="chip chip-ok">actual</span>}</h2>
            <time datetime={e.fecha} class="hint">{fecha(e.fecha)}</time>
          </header>
          <ul class="cambios">{e.cambios.map((c) => <li>{c}</li>)}</ul>
        </li>
      ))
    }
  </ol>
</App>

<style>
  .versiones { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  .version-item { display: grid; gap: 0.6rem; padding: 1rem; }
  .version-item[data-actual] { border-color: var(--accent); }
  .version-item h2 { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1.15rem; }
  .cambios { margin: 0; padding-left: 1.2rem; display: grid; gap: 0.35rem; }
</style>
