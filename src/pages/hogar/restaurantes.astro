---
import App from "@/layouts/App.astro";
import { and, eq, isNotNull } from "drizzle-orm";
import { db } from "@/db/client";
import { restaurante, type Restaurante } from "@/db/schema";
import { normalizar } from "@/lib/alimentos";
import { fechaMadrid, nombreDia } from "@/lib/fechas";
import { campo, listaRestaurantes } from "@/lib/hogar";

const usuario = Astro.locals.user!;
const hogar = Astro.locals.hogar!;
const TIPOS_COMIDA = ["Española", "Tapas", "Italiana", "Japonesa", "China", "Mexicana", "India", "Hamburguesas", "Brunch", "Asador", "Marisquería", "Vegetariana", "Pizzería", "Cafetería"];
const LIMITES = { nombre: 80, direccion: 160, tipoComida: 40, notas: 200 } as const;

const aqui = "/hogar/restaurantes";
let error = "";
let valores = { nombre: "", direccion: "", tipoComida: "", notas: "" };
/** Id del restaurante que se está editando (?editar=id o un POST con errores) */
let editando: string | null = Astro.url.searchParams.get("editar");
let valoresEdicion = { ...valores };
let errorEdicion = "";

const leer = (form: FormData) => ({
  nombre: campo(form, "nombre", LIMITES.nombre) ?? "",
  direccion: campo(form, "direccion", LIMITES.direccion) ?? "",
  tipoComida: campo(form, "tipo_comida", LIMITES.tipoComida) ?? "",
  notas: campo(form, "notas", LIMITES.notas) ?? "",
});
const aUrl = (direccion: string) => `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(direccion)}`;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const accion = String(form.get("accion") ?? "");
  const id = String(form.get("id") ?? "");
  const ahora = new Date();
  const delHogar = and(eq(restaurante.id, id), eq(restaurante.hogarId, hogar.id));

  if (accion === "anadir") {
    valores = leer(form);
    if (!valores.nombre) {
      error = "Escribe el nombre del restaurante.";
    } else {
      const { pendientes } = await listaRestaurantes(hogar.id);
      const repetido = pendientes.some((r) => normalizar(r.nombre) === normalizar(valores.nombre));
      if (!repetido) {
        await db.insert(restaurante).values({
          hogarId: hogar.id,
          nombre: valores.nombre,
          direccion: valores.direccion || null,
          tipoComida: valores.tipoComida || null,
          notas: valores.notas || null,
          creadoPor: usuario.id,
          createdAt: ahora,
          updatedAt: ahora,
        });
      }
      return Astro.redirect(`${aqui}?ok=${repetido ? "repetido" : "anadido"}`, 303);
    }
  } else if (accion === "guardar") {
    valoresEdicion = leer(form);
    editando = id;
    if (!valoresEdicion.nombre) {
      errorEdicion = "El nombre no puede quedar vacío.";
    } else {
      await db
        .update(restaurante)
        .set({
          nombre: valoresEdicion.nombre,
          direccion: valoresEdicion.direccion || null,
          tipoComida: valoresEdicion.tipoComida || null,
          notas: valoresEdicion.notas || null,
          updatedAt: ahora,
        })
        .where(delHogar);
      return Astro.redirect(`${aqui}?ok=guardado#r-${id}`, 303);
    }
  } else if (accion === "visitado") {
    await db.update(restaurante).set({ visitadoEn: ahora, updatedAt: ahora }).where(delHogar);
    return Astro.redirect(`${aqui}?ok=visitado`, 303);
  } else if (accion === "pendiente") {
    await db.update(restaurante).set({ visitadoEn: null, updatedAt: ahora }).where(delHogar);
    return Astro.redirect(`${aqui}?ok=pendiente`, 303);
  } else if (accion === "borrar") {
    await db.delete(restaurante).where(delHogar);
    return Astro.redirect(`${aqui}?ok=borrado`, 303);
  } else if (accion === "limpiar") {
    await db.delete(restaurante).where(and(eq(restaurante.hogarId, hogar.id), isNotNull(restaurante.visitadoEn)));
    return Astro.redirect(`${aqui}?ok=limpio`, 303);
  }
}

const { pendientes, visitados } = await listaRestaurantes(hogar.id);
const hoy = fechaMadrid();
const detalle = (r: Restaurante) => [r.tipoComida, r.notas].filter(Boolean).join(" · ");

// Si se pide editar por URL (sin JavaScript), precargar los valores actuales
if (editando && !errorEdicion) {
  const r = pendientes.find((x) => x.id === editando);
  if (r) valoresEdicion = { nombre: r.nombre, direccion: r.direccion ?? "", tipoComida: r.tipoComida ?? "", notas: r.notas ?? "" };
  else editando = null;
}

const MENSAJES: Record<string, string> = {
  anadido: "Apuntado en la lista.",
  repetido: "Ese restaurante ya estaba en la lista.",
  guardado: "Cambios guardados.",
  visitado: "Marcado como visitado. ¡Que aproveche!",
  pendiente: "Vuelve a estar pendiente.",
  borrado: "Borrado de la lista.",
  limpio: "Historial borrado.",
};
const ok = MENSAJES[Astro.url.searchParams.get("ok") ?? ""];
---

<App title="Restaurantes">
  <header class="grid gap-2">
    <a href="/hogar" class="btn btn-ghost volver"><span aria-hidden="true">←</span> Hogar</a>
    <h1 style="color: var(--hogar);">Restaurantes</h1>
    <p class="text-muted">Sitios a los que os apetece ir. Cuando vayáis, marcadlo y pasa al historial.</p>
  </header>

  {ok && <div class="alert alert-ok" role="status"><p>{ok}</p></div>}

  <form method="post" action={aqui} class="form-alta" novalidate>
    <input type="hidden" name="accion" value="anadir" />
    <div class="form-alta-linea con-extra">
      <div class="field">
        <label class="label" for="nombre">Restaurante</label>
        <input
          class="input"
          id="nombre"
          name="nombre"
          value={valores.nombre}
          required
          maxlength={LIMITES.nombre}
          autocomplete="off"
          placeholder="Ej.: Casa Lucio"
          aria-invalid={error ? "true" : undefined}
          aria-describedby={error ? "nombre-error" : undefined}
          autofocus={error ? true : undefined}
        />
      </div>
      <div class="field">
        <label class="label" for="tipo_comida">Tipo de comida <span class="hint">(opcional)</span></label>
        <input class="input" id="tipo_comida" name="tipo_comida" list="tipos-comida" maxlength={LIMITES.tipoComida} value={valores.tipoComida} autocomplete="off" placeholder="Tapas" />
        <datalist id="tipos-comida">{TIPOS_COMIDA.map((t) => <option value={t} />)}</datalist>
      </div>
      <button class="btn btn-primary" type="submit"><span aria-hidden="true">＋</span> Añadir</button>
    </div>
    {error && <p class="field-error" id="nombre-error">{error}</p>}
    <details class="mas-datos" open={!!(valores.direccion || valores.notas)}>
      <summary>Dirección y notas</summary>
      <div class="grid gap-3 mt-2">
        <div class="field">
          <label class="label" for="direccion">Dirección <span class="hint">(opcional)</span></label>
          <input class="input" id="direccion" name="direccion" maxlength={LIMITES.direccion} value={valores.direccion} autocomplete="off" placeholder="Calle de la Cava Baja, 35, Madrid" />
        </div>
        <div class="field">
          <label class="label" for="notas">Notas <span class="hint">(opcional)</span></label>
          <input class="input" id="notas" name="notas" maxlength={LIMITES.notas} value={valores.notas} autocomplete="off" placeholder="Nos lo recomendó Marta, hay que reservar" />
        </div>
      </div>
    </details>
  </form>

  <section class="grid gap-3" aria-labelledby="titulo-lista">
    <h2 id="titulo-lista">Por ir {pendientes.length > 0 && <span class="chip num">{pendientes.length}</span>}</h2>

    {
      pendientes.length === 0 ? (
        <div class="card vacio-lista">
          <span class="emoji" aria-hidden="true">🍽️</span>
          <p>No hay nada pendiente. Apunta el próximo sitio que os recomienden.</p>
        </div>
      ) : (
        <ul class="lista">
          {pendientes.map((r) =>
            editando === r.id ? (
              <li class="fila-edicion card" id={`r-${r.id}`}>
                <form method="post" action={aqui} class="grid gap-3" novalidate aria-label={`Editar ${r.nombre}`}>
                  <input type="hidden" name="accion" value="guardar" />
                  <input type="hidden" name="id" value={r.id} />
                  <div class="field">
                    <label class="label" for={`e-nombre-${r.id}`}>Restaurante</label>
                    <input class="input" id={`e-nombre-${r.id}`} name="nombre" value={valoresEdicion.nombre} required maxlength={LIMITES.nombre} autocomplete="off" aria-invalid={errorEdicion ? "true" : undefined} autofocus />
                    {errorEdicion && <p class="field-error">{errorEdicion}</p>}
                  </div>
                  <div class="field">
                    <label class="label" for={`e-tipo-${r.id}`}>Tipo de comida</label>
                    <input class="input" id={`e-tipo-${r.id}`} name="tipo_comida" list="tipos-comida" maxlength={LIMITES.tipoComida} value={valoresEdicion.tipoComida} autocomplete="off" />
                  </div>
                  <div class="field">
                    <label class="label" for={`e-dir-${r.id}`}>Dirección</label>
                    <input class="input" id={`e-dir-${r.id}`} name="direccion" maxlength={LIMITES.direccion} value={valoresEdicion.direccion} autocomplete="off" />
                  </div>
                  <div class="field">
                    <label class="label" for={`e-notas-${r.id}`}>Notas</label>
                    <input class="input" id={`e-notas-${r.id}`} name="notas" maxlength={LIMITES.notas} value={valoresEdicion.notas} autocomplete="off" />
                  </div>
                  <div class="flex gap-2 flex-wrap">
                    <button class="btn btn-primary" type="submit">Guardar</button>
                    <a class="btn btn-ghost" href={`${aqui}?#r-${r.id}`}>Cancelar</a>
                  </div>
                </form>
              </li>
            ) : (
              <li class="fila" id={`r-${r.id}`}>
                <form method="post" action={aqui}>
                  <input type="hidden" name="accion" value="visitado" />
                  <input type="hidden" name="id" value={r.id} />
                  <button class="marcar" type="submit" aria-pressed="false" aria-label={`Marcar ${r.nombre} como visitado`} style="--c: var(--accent)">
                    <span />
                  </button>
                </form>
                <div class="fila-texto">
                  <span class="fila-titulo">{r.nombre}</span>
                  {detalle(r) && <span class="fila-detalle">{detalle(r)}</span>}
                  {r.direccion && (
                    <a class="fila-detalle direccion" href={aUrl(r.direccion)} target="_blank" rel="noopener">
                      <span aria-hidden="true">📍 </span>{r.direccion}
                    </a>
                  )}
                </div>
                <div class="fila-acciones">
                  <a class="icono-btn" href={`${aqui}?editar=${r.id}#r-${r.id}`} aria-label={`Editar ${r.nombre}`} title="Editar">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9" /><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z" /></svg>
                  </a>
                  <form method="post" action={aqui}>
                    <input type="hidden" name="accion" value="borrar" />
                    <input type="hidden" name="id" value={r.id} />
                    <button class="icono-btn peligro" type="submit" aria-label={`Borrar ${r.nombre} de la lista`}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
                    </button>
                  </form>
                </div>
              </li>
            ),
          )}
        </ul>
      )
    }
  </section>

  {
    visitados.length > 0 && (
      <details class="historial">
        <summary>
          <span aria-hidden="true">🍴</span> Ya visitados <span class="chip num ml-auto">{visitados.length}</span>
        </summary>
        <ul class="lista">
          {visitados.map((r) => (
            <li class="fila" data-hecha>
              <span class="marcar hecho" aria-hidden="true"><span>✓</span></span>
              <div class="fila-texto">
                <span class="fila-titulo">{r.nombre}</span>
                <span class="fila-detalle">
                  {[r.tipoComida, r.visitadoEn && `visitado ${nombreDia(fechaMadrid(r.visitadoEn), hoy).toLowerCase()}`].filter(Boolean).join(" · ")}
                </span>
              </div>
              <form method="post" action={aqui}>
                <input type="hidden" name="accion" value="pendiente" />
                <input type="hidden" name="id" value={r.id} />
                <button class="icono-btn" type="submit" aria-label={`Volver a poner ${r.nombre} como pendiente`} title="Volver a la lista">
                  <span aria-hidden="true">↺</span>
                </button>
              </form>
            </li>
          ))}
        </ul>
        <form method="post" action={aqui} class="mt-3">
          <input type="hidden" name="accion" value="limpiar" />
          <button class="btn btn-ghost" type="submit" style="color: var(--danger);">Borrar historial</button>
        </form>
      </details>
    )
  }
</App>

<style>
  .mas-datos > summary { cursor: pointer; font-size: 0.9rem; font-weight: 700; color: var(--muted); min-height: 2.25rem; display: flex; align-items: center; }
  .fila-edicion { padding: 1rem; border: 2px solid var(--hogar); }
  .direccion { color: var(--hogar); text-decoration: none; }
  .direccion:hover { text-decoration: underline; }
</style>
