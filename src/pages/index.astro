---
import App from "@/layouts/App.astro";
import ItemEvento from "@/components/ItemEvento.astro";
import { hijosDe, listaNombres, miembrosDe } from "@/lib/familia";
import { eventosEnRango } from "@/lib/eventos";
import { fechaMadrid, nombreDia, sumarDias } from "@/lib/fechas";
import { db } from "@/db/client";
import { mensajeChat } from "@/db/schema";
import { and, desc, eq } from "drizzle-orm";

const user = Astro.locals.user!;
const hogar = Astro.locals.hogar!;
const hoyMadrid = fechaMadrid();
const [hijos, miembros, semana, ultimaPregunta] = await Promise.all([
  hijosDe(hogar.id),
  miembrosDe(hogar.id),
  eventosEnRango(hogar.id, hoyMadrid, sumarDias(hoyMadrid, 7)),
  db
    .select({ partes: mensajeChat.partes })
    .from(mensajeChat)
    .where(and(eq(mensajeChat.userId, user.id), eq(mensajeChat.rol, "user")))
    .orderBy(desc(mensajeChat.createdAt))
    .get(),
]);
const proximos = semana.filter((e) => !(e.tipo === "tarea" && e.completado)).slice(0, 4);
const mapaHijos = new Map(hijos.map((h) => [h.id, h.nombre]));
const mapaMiembros = new Map(miembros.map((m) => [m.id, { nombre: m.nombre, avatar: m.avatar }]));
const nombres = hijos.map((h) => h.nombre);
const bienvenida = Astro.url.searchParams.get("bienvenida");

const hora = Number(
  new Intl.DateTimeFormat("es-ES", { hour: "numeric", hour12: false, timeZone: "Europe/Madrid" }).format(new Date()),
);
const saludo = hora < 6 ? "Buenas noches" : hora < 14 ? "Buenos días" : hora < 21 ? "Buenas tardes" : "Buenas noches";
const fecha = new Intl.DateTimeFormat("es-ES", { weekday: "long", day: "numeric", month: "long", timeZone: "Europe/Madrid" }).format(new Date());

// Asistente: sugerencias y última pregunta para retomar la conversación
const bebe = hijos[0]?.nombre;
const sugerencias = [
  { txt: "Puré de calabaza y zanahoria", q: "Dame una receta de puré de calabaza y zanahoria" },
  { txt: "Cena rápida para hoy", q: "Ideas de cena rápida y sana para hoy" },
  { txt: bebe ? `¿Qué puede comer ${bebe}?` : "Primeros alimentos", q: bebe ? `¿Qué alimentos puede empezar a comer ${bebe}?` : "¿Con qué alimentos se empieza la alimentación complementaria?" },
];
let retomar = "";
try {
  const partes = ultimaPregunta ? (JSON.parse(ultimaPregunta.partes) as { type: string; text?: string }[]) : [];
  retomar = partes.map((p) => p.text ?? "").join(" ").trim();
} catch {
  /* mensaje antiguo con otro formato */
}
if (retomar.length > 60) retomar = `${retomar.slice(0, 57)}…`;

const tituloHijos = hijos.length === 1 ? nombres[0] : hijos.length > 1 ? "Hijos" : "Hijo/a";
const textoHijos =
  hijos.length > 0
    ? `Comidas, salud y crecimiento de ${listaNombres(nombres)}.`
    : "Añade a tus hijos en Mi perfil para empezar.";
---

<App title="Inicio">
  {
    bienvenida && (
      <div class="alert alert-ok" role="status">
        <p>{bienvenida === "unido" ? `Te has unido a «${hogar.nombre}». Ya veis los mismos datos.` : "Cuenta creada. Ya puedes empezar a organizaros."}</p>
      </div>
    )
  }

  <header class="flex items-center gap-4">
    <span class="grid place-items-center size-16 shrink-0 rounded-full text-4xl" style="background: var(--surface-2);" aria-hidden="true">
      {user.avatar}
    </span>
    <div class="min-w-0">
      <p class="text-muted first-letter:uppercase">{fecha}</p>
      <h1>{saludo}, {user.name}</h1>
    </div>
  </header>

  <section class="llito" aria-labelledby="sec-llito">
    <div class="llito-cabecera">
      <span class="llito-icono" aria-hidden="true">✨</span>
      <div class="min-w-0">
        <h2 id="sec-llito">Pregúntale a Llito</h2>
        <p class="llito-sub">Recetas, ideas y dudas del día a día. Lo que guarda, lo recuerda.</p>
      </div>
    </div>
    <form action="/asistente" method="get" class="llito-form">
      <label for="llito-q" class="sr-only">Pregunta para Llito</label>
      <input
        id="llito-q"
        name="q"
        class="llito-input"
        placeholder={bebe ? `¿Qué le preparo hoy a ${bebe}?` : "¿En qué te ayudo hoy?"}
        maxlength="2000"
        required
        autocomplete="off"
        enterkeyhint="send"
      />
      <button class="llito-enviar" type="submit" aria-label="Preguntar a Llito">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
      </button>
    </form>
    <ul class="llito-chips" aria-label="Sugerencias">
      {sugerencias.map((s) => <li><a href={`/asistente?q=${encodeURIComponent(s.q)}`}>{s.txt}</a></li>)}
    </ul>
    {
      retomar && (
        <a href="/asistente" class="llito-retomar">
          <span class="min-w-0 truncate">Seguir: «{retomar}»</span>
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </section>

  <a href="/mi-perfil/familia" class="familia">
    <span class="flex -space-x-2" aria-hidden="true">
      {miembros.map((m) => <span class="familia-avatar">{m.avatar}</span>)}
    </span>
    <span class="min-w-0">
      <span class="block font-bold">{hogar.nombre}</span>
      <span class="block hint">
        {miembros.length === 1 ? "Solo tú por ahora · Invita a tu pareja" : listaNombres(miembros.map((m) => m.nombre))}
      </span>
    </span>
  </a>

  <section aria-labelledby="sec-proximo" class="grid gap-3">
    <div class="flex items-baseline justify-between gap-2">
      <h2 id="sec-proximo">Próximos días</h2>
      <a href="/agenda" class="font-bold">Ver agenda</a>
    </div>
    {
      proximos.length > 0 ? (
        <ul class="grid gap-2 list-none p-0 m-0">
          {proximos.map((e) => (
            <ItemEvento evento={e} hijos={mapaHijos} miembros={mapaMiembros} volver="/" mostrarDia={nombreDia(e.dia, hoyMadrid)} />
          ))}
        </ul>
      ) : (
        <div class="card grid gap-3 justify-items-start">
          <p class="text-muted">No hay nada apuntado para esta semana.</p>
          <a href="/agenda/nuevo" class="btn btn-secondary">Añadir una cita o tarea</a>
        </div>
      )
    }
  </section>

  <section aria-labelledby="sec-secciones" class="grid gap-4">
    <h2 id="sec-secciones" class="sr-only">Secciones</h2>
    <ul class="grid gap-4 sm:grid-cols-2 list-none p-0 m-0">
      <li>
        <a href="/hogar" class="seccion" style="--c: var(--hogar); --c-soft: var(--hogar-soft);">
          <span class="seccion-icono" aria-hidden="true">🏠</span>
          <span class="grid gap-1">
            <span class="seccion-titulo">Hogar</span>
            <span class="seccion-texto">Tareas, lista de la compra y agenda de la familia.</span>
          </span>
          <span class="seccion-flecha" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="/hijos" class="seccion" style="--c: var(--hijos); --c-soft: var(--hijos-soft);">
          <span class="seccion-icono" aria-hidden="true">🍼</span>
          <span class="grid gap-1">
            <span class="seccion-titulo">{tituloHijos}</span>
            <span class="seccion-texto">{textoHijos}</span>
          </span>
          <span class="seccion-flecha" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </section>
</App>

<style>
  .llito {
    display: grid;
    gap: 0.9rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, var(--hijos-soft) 0%, transparent 55%),
      linear-gradient(135deg, var(--accent-soft), var(--surface));
    border: 1px solid var(--line);
  }
  .llito-cabecera { display: flex; align-items: center; gap: 0.85rem; }
  .llito-icono {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 16px;
    background: var(--surface);
    font-size: 1.5rem;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.06);
  }
  .llito-sub { color: var(--muted); font-size: 0.92rem; }
  .llito-form {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.3rem 0.3rem 1rem;
    border-radius: 999px;
    background: var(--surface);
    border: 2px solid var(--line);
  }
  .llito-form:focus-within { border-color: var(--accent); outline: 3px solid var(--focus); outline-offset: 2px; }
  .llito-input {
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    outline: none;
  }
  .llito-enviar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 0;
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
  }
  .llito-enviar svg { width: 1.3rem; height: 1.3rem; }
  .llito-chips { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .llito-chips a {
    display: inline-flex;
    align-items: center;
    min-height: 2.5rem;
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .llito-chips a:hover { border-color: var(--accent); color: var(--accent); }
  .llito-retomar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.5rem;
    font-weight: 700;
    font-size: 0.92rem;
    text-decoration: none;
  }
  .familia {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.75rem 1rem;
    min-height: var(--tap);
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
  }
  .familia:hover { border-color: var(--muted); }
  .familia-avatar {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 2px solid var(--surface);
    font-size: 1.25rem;
  }
  .seccion {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 8.5rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--c-soft);
    color: var(--ink);
    text-decoration: none;
    border: 2px solid transparent;
    transition: border-color 0.15s, transform 0.1s;
  }
  .seccion:hover { border-color: var(--c); }
  .seccion:active { transform: scale(0.99); }
  .seccion-icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 18px;
    background: var(--surface);
    font-size: 1.9rem;
  }
  .seccion-titulo {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--c);
  }
  .seccion-texto { color: var(--ink); font-size: 0.95rem; }
  .seccion-flecha { font-size: 1.4rem; color: var(--c); font-weight: 700; }
</style>
