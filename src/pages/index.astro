---
import App from "@/layouts/App.astro";
import { hijosDe, listaNombres, miembrosDe } from "@/lib/familia";
import { eventosEnRango, textoHora, TIPOS } from "@/lib/eventos";
import { fechaMadrid, horaMadrid, nombreDia, sumarDias } from "@/lib/fechas";
import { VERSION } from "@/lib/version";
import InstalarApp from "@/components/InstalarApp.astro";
import { db } from "@/db/client";
import { mensajeChat } from "@/db/schema";
import { and, desc, eq } from "drizzle-orm";

const user = Astro.locals.user!;
const hogar = Astro.locals.hogar!;
const hoyMadrid = fechaMadrid();
const [hijos, miembros, semana, ultimaPregunta] = await Promise.all([
  hijosDe(hogar.id),
  miembrosDe(hogar.id),
  eventosEnRango(hogar.id, hoyMadrid, sumarDias(hoyMadrid, 10)),
  db
    .select({ partes: mensajeChat.partes })
    .from(mensajeChat)
    .where(and(eq(mensajeChat.userId, user.id), eq(mensajeChat.rol, "user")))
    .orderBy(desc(mensajeChat.createdAt))
    .get(),
]);
const pendientesSemana = semana.filter((e) => !(e.tipo === "tarea" && e.completado));
// Previsión a 10 días, agrupada por día
const porDia = new Map<string, typeof pendientesSemana>();
for (const e of pendientesSemana) porDia.set(e.dia, [...(porDia.get(e.dia) ?? []), e]);
const diasPrevision = [...porDia.entries()];
const fmtDiaCorto = new Intl.DateTimeFormat("es-ES", { weekday: "short", timeZone: "UTC" });
const fmtDiaNum = new Intl.DateTimeFormat("es-ES", { day: "numeric", month: "short", timeZone: "UTC" });
const etiquetaDia = (dia: string) => {
  const d = new Date(`${dia}T12:00:00Z`);
  const rel = nombreDia(dia, hoyMadrid);
  const corto = fmtDiaCorto.format(d).replace(".", "");
  return { rel: rel.charAt(0).toUpperCase() + rel.slice(1), corto: corto.charAt(0).toUpperCase() + corto.slice(1), num: fmtDiaNum.format(d).replace(".", "") };
};

// Aviso: lo que queda de hoy y lo de mañana
const manana = sumarDias(hoyMadrid, 1);
const ahora = horaMadrid(new Date());
const avisos = pendientesSemana.filter(
  (e) => e.dia === manana || (e.dia === hoyMadrid && (e.todoElDia || !e.horaInicio || (e.horaFin ?? e.horaInicio) >= ahora)),
);
const avisosHoy = avisos.filter((e) => e.dia === hoyMadrid).length;
const avisosManana = avisos.length - avisosHoy;
const tituloAviso =
  avisosHoy && avisosManana
    ? "Para hoy y mañana"
    : avisosHoy
      ? `Hoy tienes ${avisosHoy === 1 ? "algo apuntado" : `${avisosHoy} cosas`}`
      : `Mañana tienes ${avisosManana === 1 ? (avisos[0].tipo === "evento" ? "un plan" : "algo apuntado") : `${avisosManana} cosas`}`;
// Clave del aviso: si cambia lo que hay, vuelve a aparecer aunque se hubiera cerrado
const claveAviso = `${hoyMadrid}:${avisos.map((e) => `${e.id}@${e.dia}`).join(",")}`;
const mapaHijos = new Map(hijos.map((h) => [h.id, h.nombre]));
const nombres = hijos.map((h) => h.nombre);
const bienvenida = Astro.url.searchParams.get("bienvenida");

const hora = Number(
  new Intl.DateTimeFormat("es-ES", { hour: "numeric", hour12: false, timeZone: "Europe/Madrid" }).format(new Date()),
);
const saludo = hora < 6 ? "Buenas noches" : hora < 14 ? "Buenos días" : hora < 21 ? "Buenas tardes" : "Buenas noches";
const fecha = new Intl.DateTimeFormat("es-ES", { weekday: "long", day: "numeric", month: "long", timeZone: "Europe/Madrid" }).format(new Date());

// Asistente: sugerencias y última pregunta para retomar la conversación
const bebe = hijos[0]?.nombre;
const sugerencias = [
  { txt: "Puré de calabaza y zanahoria", q: "Dame una receta de puré de calabaza y zanahoria" },
  { txt: "Cena rápida para hoy", q: "Ideas de cena rápida y sana para hoy" },
  { txt: bebe ? `¿Qué puede comer ${bebe}?` : "Primeros alimentos", q: bebe ? `¿Qué alimentos puede empezar a comer ${bebe}?` : "¿Con qué alimentos se empieza la alimentación complementaria?" },
];
let retomar = "";
try {
  const partes = ultimaPregunta ? (JSON.parse(ultimaPregunta.partes) as { type: string; text?: string }[]) : [];
  retomar = partes.map((p) => p.text ?? "").join(" ").trim();
} catch {
  /* mensaje antiguo con otro formato */
}
if (retomar.length > 60) retomar = `${retomar.slice(0, 57)}…`;

const tituloHijos = hijos.length === 1 ? nombres[0] : hijos.length > 1 ? "Hijos" : "Hijo/a";
const textoHijos =
  hijos.length > 0
    ? `Comidas, salud y crecimiento de ${listaNombres(nombres)}.`
    : "Añade a tus hijos en Mi perfil para empezar.";
---

<App title="Inicio" ancho>
  {
    bienvenida && (
      <div class="alert alert-ok" role="status">
        <p>{bienvenida === "unido" ? `Te has unido a «${hogar.nombre}». Ya veis los mismos datos.` : "Cuenta creada. Ya puedes empezar a organizaros."}</p>
      </div>
    )
  }

  <div class="inicio">
  <div class="inicio-col">
  <header class="grid gap-3">
    <div class="flex items-center gap-4">
      <span class="grid place-items-center size-16 shrink-0 rounded-full text-4xl" style="background: var(--surface-2);" aria-hidden="true">
        {user.avatar}
      </span>
      <div class="min-w-0">
        <p class="text-muted first-letter:uppercase">{fecha}</p>
        <h1 class="saludo">{saludo}, {user.name}</h1>
      </div>
    </div>
    <span class="tiempo" data-tiempo hidden role="img" aria-label="Tiempo de hoy"></span>
  </header>


  {
    avisos.length > 0 && (
      <section class="aviso-proximo" aria-labelledby="aviso-titulo" data-aviso={claveAviso}>
        <span class="aviso-campana" aria-hidden="true">🔔</span>
        <div class="grid gap-2 min-w-0">
          <h2 id="aviso-titulo">{tituloAviso}</h2>
          <ul class="aviso-lista">
            {avisos.slice(0, 4).map((e) => (
              <li>
                <a href={`/agenda/${e.id}`}>
                  <span class="aviso-cuando">
                    {e.dia === hoyMadrid ? "Hoy" : "Mañana"} · {textoHora(e)}
                  </span>
                  <span class="aviso-que">
                    <span aria-hidden="true">{TIPOS[e.tipo].emoji} </span>
                    {e.titulo}
                    {e.ubicacion && <span class="aviso-donde"> · {e.ubicacion}</span>}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
        <button type="button" class="aviso-cerrar" data-cerrar-aviso aria-label="Ocultar este aviso">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </section>
    )
  }
  <script is:inline>
    (() => {
      const aviso = document.querySelector("[data-aviso]");
      if (!aviso) return;
      const clave = aviso.getAttribute("data-aviso");
      try {
        if (localStorage.getItem("aviso-cerrado") === clave) aviso.hidden = true;
      } catch {}
      aviso.querySelector("[data-cerrar-aviso]")?.addEventListener("click", () => {
        aviso.hidden = true;
        try {
          localStorage.setItem("aviso-cerrado", clave);
        } catch {}
      });
    })();
  </script>

  <section aria-labelledby="sec-proximo" class="grid gap-3">
    <div class="flex items-baseline justify-between gap-2">
      <h2 id="sec-proximo">Próximos 10 días</h2>
      <a href="/agenda" class="font-bold enlace-tap">Ver agenda</a>
    </div>
    {
      diasPrevision.length > 0 ? (
        <ol class="prevision">
          {diasPrevision.map(([dia, eventos]) => {
            const et = etiquetaDia(dia);
            const esHoy = dia === hoyMadrid;
            return (
              <li class="prevision-dia" data-hoy={esHoy ? "si" : undefined}>
                <a href={`/agenda?dia=${dia}`} class="prevision-fecha" aria-label={`${et.rel}, ${et.num}`}>
                  <span class="prevision-rel">{dia === hoyMadrid || dia === sumarDias(hoyMadrid, 1) ? et.rel : et.corto}</span>
                  <span class="prevision-num">{et.num}</span>
                </a>
                <ul class="prevision-lista">
                  {eventos.map((e) => (
                    <li>
                      <a href={`/agenda/${e.id}`} class="prevision-evento" style={`--c: ${TIPOS[e.tipo].color}`}>
                        <span class="prevision-hora">{e.todoElDia ? "Todo el día" : textoHora(e)}</span>
                        <span class="prevision-titulo">
                          <span aria-hidden="true">{TIPOS[e.tipo].emoji} </span>
                          {e.titulo}
                          {e.hijoId && mapaHijos.get(e.hijoId) && <span class="prevision-quien"> · {mapaHijos.get(e.hijoId)}</span>}
                        </span>
                        {e.ubicacion && <span class="prevision-donde">{e.ubicacion}</span>}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            );
          })}
        </ol>
      ) : (
        <div class="card grid gap-3 justify-items-start">
          <p class="text-muted">Nada apuntado para los próximos 10 días.</p>
          <a href="/agenda/nuevo" class="btn btn-secondary">Añadir una cita o tarea</a>
        </div>
      )
    }
  </section>

  <section class="llito" aria-labelledby="sec-llito">
    <div class="llito-cabecera">
      <span class="llito-icono" aria-hidden="true">✨</span>
      <div class="min-w-0">
        <h2 id="sec-llito">Pregúntale a Kissbell</h2>
        <p class="llito-sub">Recetas, ideas y dudas del día a día. Lo que guarda, lo recuerda.</p>
      </div>
    </div>
    <form action="/asistente" method="get" class="llito-form" data-llito-form>
      <label for="llito-q" class="sr-only">Pregunta para Kissbell</label>
      <input
        id="llito-q"
        name="q"
        class="llito-input"
        placeholder="Pregúntale algo…"
        maxlength="2000"
        required
        autocomplete="off"
        enterkeyhint="send"
      />
      <button class="llito-voz" type="button" data-voz aria-label="Dictar por voz" aria-pressed="false" title="Dictar por voz">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" /><path d="M5 11a7 7 0 0 0 14 0M12 18v3M9 21h6" /></svg>
      </button>
      <button class="llito-enviar" type="submit" aria-label="Preguntar a Kissbell">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M5 12l7-7 7 7" /></svg>
      </button>
    </form>
    <ul class="llito-chips" aria-label="Sugerencias">
      {sugerencias.map((s) => <li><a href={`/asistente?q=${encodeURIComponent(s.q)}`}>{s.txt}</a></li>)}
    </ul>
    {
      retomar && (
        <a href="/asistente" class="llito-retomar">
          <span class="min-w-0 truncate">Seguir: «{retomar}»</span>
          <span aria-hidden="true">→</span>
        </a>
      )
    }
  </section>

  <InstalarApp cerrable />

  <a href="/mi-perfil/familia" class="familia">
    <span class="flex -space-x-2" aria-hidden="true">
      {miembros.map((m) => <span class="familia-avatar">{m.avatar}</span>)}
    </span>
    <span class="min-w-0">
      <span class="block font-bold">{hogar.nombre}</span>
      <span class="block hint">
        {miembros.length === 1 ? "Solo tú por ahora · Invita a tu pareja" : listaNombres(miembros.map((m) => m.nombre))}
      </span>
    </span>
  </a>

  </div>
  <div class="inicio-col">
  <section aria-labelledby="sec-secciones" class="grid gap-4">
    <h2 id="sec-secciones" class="sr-only">Secciones</h2>
    <ul class="secciones-grid">
      <li>
        <a href="/hogar" class="seccion" style="--c: var(--hogar); --c-soft: var(--hogar-soft);">
          <span class="seccion-icono" aria-hidden="true">🏠</span>
          <span class="grid gap-1">
            <span class="seccion-titulo">Hogar</span>
            <span class="seccion-texto">Agenda, compra, limpieza, pelis y restaurantes.</span>
          </span>
          <span class="seccion-flecha" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="/hijos" class="seccion" style="--c: var(--hijos); --c-soft: var(--hijos-soft);">
          <span class="seccion-icono" aria-hidden="true">🍼</span>
          <span class="grid gap-1">
            <span class="seccion-titulo">{tituloHijos}</span>
            <span class="seccion-texto">{textoHijos}</span>
          </span>
          <span class="seccion-flecha" aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a href="/galeria" class="seccion" style="--c: var(--accent); --c-soft: var(--accent-soft);">
          <span class="seccion-icono" aria-hidden="true">📸</span>
          <span class="grid gap-1">
            <span class="seccion-titulo">Galería</span>
            <span class="seccion-texto">Fotos y vídeos de la familia, en vuestro Google Drive.</span>
          </span>
          <span class="seccion-flecha" aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </section>
  </div>
  </div>
  <p class="version"><a href="/novedades" class="enlace-tap">App-Llito v{VERSION} · Novedades</a></p>
</App>

<script>
  import { mostrarTiempo } from "@/scripts/tiempo";
  import { activarVoz } from "@/scripts/voz";
  const tiempo = document.querySelector<HTMLElement>("[data-tiempo]");
  if (tiempo) mostrarTiempo(tiempo);
  const form = document.querySelector<HTMLFormElement>("[data-llito-form]");
  const campo = form?.querySelector<HTMLInputElement>("input[name=q]");
  const voz = form?.querySelector<HTMLButtonElement>("[data-voz]");
  if (form && campo && voz) {
    const placeholder = campo.placeholder;
    activarVoz(voz, {
      alParcial: (t) => (campo.value = t),
      alTexto: (t) => {
        campo.value = t;
        form.submit();
      },
      alEstado: (e, detalle) => {
        campo.placeholder = e === "escuchando" ? "Te escucho…" : placeholder;
        if (e === "error" && detalle) {
          campo.value = "";
          campo.placeholder = detalle;
          setTimeout(() => (campo.placeholder = placeholder), 5000);
        }
      },
    });
  }
</script>

<style>
  .saludo { font-size: clamp(1.55rem, 7.2vw, 2.2rem); line-height: 1.1; }
  .inicio { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; }
  .secciones-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; }
  @media (min-width: 640px) and (max-width: 1023px) { .secciones-grid { grid-template-columns: 1fr 1fr; } }
  .inicio-col { display: grid; grid-template-columns: minmax(0, 1fr); gap: 1.5rem; align-content: start; min-width: 0; }
  @media (min-width: 1024px) {
    .inicio { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 2rem; align-items: start; }
    .inicio-col:last-child { position: sticky; top: 5.5rem; }
  }
  .aviso-proximo {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.85rem;
    align-items: start;
    padding: 1rem 0.5rem 1rem 1rem;
    border-radius: var(--radius-lg);
    background: var(--aviso-soft);
    border: 2px solid var(--aviso);
  }
  .aviso-proximo[hidden] { display: none; }
  .aviso-proximo h2 { font-size: 1.1rem; color: var(--ink); }
  .aviso-campana {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 14px;
    background: var(--surface);
    font-size: 1.3rem;
    animation: campana 1.2s ease-in-out 0.4s 2;
    transform-origin: 50% 15%;
  }
  @keyframes campana {
    0%, 100% { transform: rotate(0); }
    20% { transform: rotate(14deg); }
    40% { transform: rotate(-12deg); }
    60% { transform: rotate(8deg); }
    80% { transform: rotate(-4deg); }
  }
  .aviso-lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.35rem; }
  .aviso-lista a {
    display: grid;
    gap: 0.05rem;
    min-height: 2.75rem;
    align-content: center;
    padding: 0.35rem 0.7rem;
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--ink);
    text-decoration: none;
  }
  .aviso-lista a:hover { outline: 2px solid var(--aviso); }
  .aviso-cuando { font-size: 0.82rem; font-weight: 700; color: var(--aviso); font-variant-numeric: tabular-nums; }
  .aviso-que { font-weight: 700; overflow-wrap: anywhere; }
  .aviso-donde { font-weight: 400; color: var(--muted); }
  .aviso-cerrar {
    display: grid;
    place-items: center;
    width: var(--tap);
    height: var(--tap);
    margin-top: -0.5rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .aviso-cerrar:hover { background: var(--surface); color: var(--ink); }
  .aviso-cerrar svg { width: 1.2rem; height: 1.2rem; }
  .llito {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.9rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(120% 140% at 100% 0%, var(--hijos-soft) 0%, transparent 55%),
      linear-gradient(135deg, var(--accent-soft), var(--surface));
    border: 1px solid var(--line);
  }
  .llito-cabecera { display: flex; align-items: center; gap: 0.85rem; }
  .llito-icono {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 16px;
    background: var(--surface);
    font-size: 1.5rem;
    box-shadow: 0 2px 10px rgb(0 0 0 / 0.06);
  }
  .llito h2 { font-size: clamp(1.15rem, 5.2vw, 1.4rem); }
  .llito-sub { color: var(--muted); font-size: 0.92rem; }
  .llito-form {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.25rem;
    padding: 0.3rem 0.3rem 0.3rem 1rem;
    border-radius: 999px;
    background: var(--surface);
    border: 2px solid var(--line);
  }
  .llito-form:focus-within { border-color: var(--accent); outline: 3px solid var(--focus); outline-offset: 2px; }
  .llito-input {
    min-width: 0;
    min-height: 2.75rem;
    border: 0;
    background: transparent;
    color: var(--ink);
    font: inherit;
    outline: none;
  }
  .llito-enviar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 0;
    background: var(--accent);
    color: var(--accent-ink);
    cursor: pointer;
  }
  .llito-enviar svg { width: 1.3rem; height: 1.3rem; }
  .llito-voz {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    position: relative;
  }
  .llito-voz:hover { background: var(--surface-2); color: var(--ink); }
  .llito-voz[hidden] { display: none; }
  .llito-voz svg { width: 1.35rem; height: 1.35rem; }
  .llito-voz.escuchando { background: var(--danger); color: #fff; }
  .llito-voz.escuchando::before {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 999px;
    border: 2px solid var(--danger);
    animation: pulso 1.2s ease-out infinite;
  }
  @keyframes pulso {
    from { transform: scale(0.9); opacity: 0.8; }
    to { transform: scale(1.35); opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .llito-voz.escuchando::before { animation: none; } }

  /* Tiempo en la cabecera */
  .tiempo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem 0.4rem 0.5rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    justify-self: start;
    max-width: 100%;
  }
  .tiempo[hidden] { display: none; }
  .tiempo :global(.tiempo-icono) { font-size: 1.6rem; line-height: 1; }
  .tiempo :global(.tiempo-datos) { display: grid; gap: 0.1rem; line-height: 1.2; min-width: 0; }
  .tiempo :global(.tiempo-linea) { font-weight: 600; }
  .tiempo :global(.tiempo-datos strong) { font-family: var(--font-display); font-size: 1.2rem; }
  .tiempo { border-radius: var(--radius-lg); padding: 0.5rem 0.9rem 0.5rem 0.6rem; }
  .tiempo :global(.tiempo-detalle) { font-size: 0.85rem; color: var(--muted); }

  /* Previsión a 10 días */
  .prevision { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.6rem; }
  .prevision-dia {
    display: grid;
    grid-template-columns: 3.4rem 1fr;
    gap: 0.6rem;
    align-items: start;
  }
  .prevision-fecha {
    display: grid;
    justify-items: center;
    gap: 0.05rem;
    padding: 0.45rem 0.2rem;
    border-radius: 14px;
    background: var(--surface);
