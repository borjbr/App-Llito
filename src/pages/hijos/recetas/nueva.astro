---
import App from "@/layouts/App.astro";
import FormReceta from "@/components/FormReceta.astro";
import { guardarReceta, leerFormReceta, valoresVacios } from "@/lib/recetas";
import type { Errores } from "@/lib/validacion";

const usuario = Astro.locals.user!;
const hogar = Astro.locals.hogar!;
let valores = valoresVacios();
let errores: Errores = {};

if (Astro.request.method === "POST") {
  const leido = leerFormReceta(await Astro.request.formData());
  valores = leido.valores;
  errores = leido.errores;
  if (leido.datos) {
    const res = await guardarReceta(hogar.id, usuario.id, leido.datos);
    if (res.ok) return Astro.redirect(`/hijos/recetas/${res.receta.id}?ok=creada`, 303);
    errores = { titulo: res.error };
  }
}
---

<App title="Nueva receta">
  <header class="grid gap-2">
    <a href="/hijos/recetas" class="btn btn-ghost justify-self-start -ml-3"><span aria-hidden="true">←</span> Recetario</a>
    <h1>Nueva receta</h1>
  </header>
  <FormReceta valores={valores} errores={errores} textoBoton="Guardar receta" />
</App>
