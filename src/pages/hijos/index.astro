---
import App from "@/layouts/App.astro";
import { hijosDe } from "@/lib/familia";
import { db } from "@/db/client";
import { receta } from "@/db/schema";
import { count, eq } from "drizzle-orm";

const hogar = Astro.locals.hogar!;
const [hijos, [{ total }]] = await Promise.all([
  hijosDe(hogar.id),
  db.select({ total: count() }).from(receta).where(eq(receta.hogarId, hogar.id)),
]);
---

<App title="Hijos">
  <header class="grid gap-2">
    <h1 style="color: var(--hijos);">{hijos.length === 1 ? hijos[0].nombre : "Hijos"}</h1>
    <p class="text-muted">Tomas, comidas, salud y crecimiento. Lo construimos en los próximos pasos.</p>
  </header>

  {
    hijos.length === 0 ? (
      <div class="card grid gap-3 justify-items-start">
        <p>Todavía no has añadido a ningún hijo o hija.</p>
        <a href="/mi-perfil#tiene_hijos" class="btn btn-primary">Añadir en Mi perfil</a>
      </div>
    ) : (
      <ul class="grid gap-3 list-none p-0 m-0">
        {hijos.map((h) => (
          <li class="card flex items-center gap-4">
            <span class="grid place-items-center size-14 shrink-0 rounded-full text-2xl font-bold font-display" style="background: var(--hijos-soft); color: var(--hijos);" aria-hidden="true">
              {h.nombre.charAt(0).toUpperCase()}
            </span>
            <div class="grid gap-1 min-w-0">
              <h2 class="break-words">{h.nombre}</h2>
              <p class="text-muted">Tomas y comidas · Salud · Crecimiento</p>
            </div>
          </li>
        ))}
      </ul>
    )
  }

  <a href="/hijos/recetas" class="recetario">
    <span class="recetario-icono" aria-hidden="true">🥣</span>
    <span class="grid gap-1">
      <span class="recetario-titulo">Recetario</span>
      <span>
        {total === 0 ? "Purés, papillas y comidas de la familia." : `${total} ${total === 1 ? "receta guardada" : "recetas guardadas"} · Purés, papillas y comidas.`}
      </span>
    </span>
    <span class="recetario-flecha" aria-hidden="true">→</span>
  </a>
</App>

<style>
  .recetario {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: var(--radius-lg);
    background: var(--hijos-soft);
    color: var(--ink);
    text-decoration: none;
    border: 2px solid transparent;
    transition: border-color 0.15s, transform 0.1s;
  }
  .recetario:hover { border-color: var(--hijos); }
  .recetario:active { transform: scale(0.99); }
  .recetario-icono {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 18px;
    background: var(--surface);
    font-size: 1.9rem;
  }
  .recetario-titulo {
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--hijos);
  }
  .recetario-flecha { font-size: 1.4rem; color: var(--hijos); font-weight: 700; }
</style>
